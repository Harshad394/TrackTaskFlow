# ── TrackTaskFlow Docker Compose Environment Variables ─────────────────────────
# Copy this file to '.env' in the same folder and fill in the values before running:
# docker compose up -d

# MongoDB connection string (e.g., cloud Atlas connection)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dbname

# JWT secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Frontend URL (optional, defaults to http://localhost:3000)
FRONTEND_ORIGINS=http://localhost:3000
