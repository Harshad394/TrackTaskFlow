PORT=5003
MONGO_URI=mongodb://localhost:27017/tracktaskflow
NODE_ENV=development
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me

# Comma-separated frontend origins allowed to send cookies.
# For Next.js local dev, keep http://localhost:3000.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# For local Next.js + API on localhost, lax is best.
# For cross-site production frontend/backend domains, use COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional production cookie domain, for example .yourdomain.com
COOKIE_DOMAIN=

# ── Redis ────────────────────────────────────────────────────────────────────
# Optional in development – the server starts normally if Redis is unavailable.
# Required in production for caching and session features.
# Format: redis://[:password@]host[:port][/db-index]
# Example: redis://localhost:6379
REDIS_URL=

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Optional in development – the server starts normally if PostgreSQL is unavailable.
# Existing MongoDB data is NOT affected; this is an additive connection for new
# relational features (analytics, audit logs, etc.).
# Format: postgresql://[user[:password]@][host][:port][/dbname][?param=value]
# Example: postgresql://postgres:password@localhost:5432/tracktaskflow
DATABASE_URL=
