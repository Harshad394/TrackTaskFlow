{
  "info": {
    "name": "TrackTaskFlow API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "organizationId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "sectionId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "commentId",
      "value": ""
    },
    {
      "key": "timeLogId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/organizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Studio\"\n}"
            }
          }
        },
        {
          "name": "List Organizations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/organizations/{{organizationId}}/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website Redesign\",\n  \"description\": \"Client project\",\n  \"key\": \"WEB\"\n}"
            }
          }
        },
        {
          "name": "Add Project Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/projects/{{projectId}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"role\": \"DEVELOPER\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Board And Tasks",
      "item": [
        {
          "name": "Get Board",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/board"
          }
        },
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/sections/{{sectionId}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Build login page\",\n  \"description\": \"Create UI and connect auth API\",\n  \"priority\": \"high\",\n  \"type\": \"task\",\n  \"labels\": [\"frontend\", \"auth\"],\n  \"dueDate\": \"2026-06-01\"\n}"
            }
          }
        },
        {
          "name": "Search And Filter Tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/tasks?q=login&priority=high&type=task&labels=frontend"
          }
        },
        {
          "name": "Move Task",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/move",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"section\": \"{{sectionId}}\",\n  \"order\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Looks good to me.\"\n}"
            }
          }
        },
        {
          "name": "List Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}/comments"
          }
        }
      ]
    },
    {
      "name": "Time Logs",
      "item": [
        {
          "name": "Create Time Log",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tasks/{{taskId}}/time-logs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minutes\": 90,\n  \"note\": \"Implemented API integration\",\n  \"billable\": true,\n  \"loggedAt\": \"2026-05-22T10:00:00.000Z\"\n}"
            }
          }
        },
        {
          "name": "List Task Time Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tasks/{{taskId}}/time-logs"
          }
        },
        {
          "name": "List Project Time Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/{{projectId}}/time-logs?billable=true"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "List Unread Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications?unreadOnly=true"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    }
  ]
}
